# ---------------------------------------------------------------
# Copia este archivo como "application.properties" (en esta misma carpeta)
# y llena tus datos. application.properties NO se sube a GitHub.
# ---------------------------------------------------------------
server.port=8080

# PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/control_alumnos
spring.datasource.username=TU_USUARIO_POSTGRES
spring.datasource.password=TU_CONTRASENA_POSTGRES

# Flyway crea las tablas y carga los datos de prueba (db/migration)
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false

# Evita la contraseña aleatoria que Spring Security imprime al arrancar
spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.security.servlet.UserDetailsServiceAutoConfiguration

# JWT: el secreto debe tener al menos 32 caracteres. Usa uno distinto en el VPS.
app.jwt.secret=CAMBIA_ESTE_SECRETO_POR_UNA_CADENA_LARGA_Y_ALEATORIA_DE_32_O_MAS
app.jwt.expiration-minutes=60

# Origenes permitidos (frontend), separados por coma
app.cors.allowed-origins=http://localhost:5173,https://t3act8eq03.tech

# Correo (recuperación de contraseña). En local déjalo comentado: el enlace se imprime en la consola.
# En el VPS se envía por Postfix instalado en el mismo servidor.
#spring.mail.host=localhost
#spring.mail.port=25
#spring.mail.properties.mail.smtp.starttls.enable=false
app.mail.from=no-reply@t3act8eq03.tech
# URL pública del frontend (para armar el enlace del correo)
app.frontend-url=http://localhost:5173

# Twilio (SMS y WhatsApp). Pon TUS credenciales solo en el application.properties real, nunca aquí.
# El número de WhatsApp del sandbox lo muestra la consola de Twilio (Messaging > Try it out).
app.twilio.account-sid=TU_ACCOUNT_SID
app.twilio.auth-token=TU_AUTH_TOKEN
app.twilio.sms-from=+1XXXXXXXXXX
app.twilio.whatsapp-from=whatsapp:+14155238886
# Solo cuenta TRIAL: el SMS acepta únicamente un nombre de plantilla (p. ej. sms_account_alerts) y WhatsApp un ContentSid
# de plantilla del sandbox (HX...) con sus variables en JSON. Con cuenta mejorada déjalas vacías (se envía texto libre).
app.twilio.sms-template=
app.twilio.whatsapp-content-sid=
app.twilio.whatsapp-content-variables=
