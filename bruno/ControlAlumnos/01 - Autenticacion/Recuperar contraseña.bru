meta {
  name: Recuperar contraseña
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/recuperar
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "TOKEN_DE_RECUPERACION",
    "nueva": "NuevaClave2027!"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
