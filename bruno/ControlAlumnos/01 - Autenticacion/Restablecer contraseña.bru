meta {
  name: Restablecer contraseña
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/restablecer
  body: json
  auth: none
}

body:json {
  {
    "token": "TOKEN_RECIBIDO_POR_CORREO",
    "nueva": "NuevaPassword2026!"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
