meta {
  name: Registrar carrera
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/carreras
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{tokenAdmin}}
  Content-Type: application/json
}

body:json {
  {
    "clave": "ISC",
    "nombre": "Ingenieria en Sistemas Computacionales",
    "duracionSemestres": 9,
    "activa": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
